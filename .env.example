
# Ollama endpoint
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Small model suitable for CPU/8GB RAM
OLLAMA_MODEL=qwen2.5:1.5b

# Alex response style: serious | light_humor
ALEX_TONE=serious

# LiveKit voice runtime
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=birthday-interrogation
LIVEKIT_IDENTITY=alex-agent

# Deepgram API keys
VOICE_STT_API_KEY=
VOICE_TTS_API_KEY=
VOICE_TTS_PROVIDER=cartesia

# Deepgram model settings
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-2-orion-en

# Cartesia TTS settings
CARTESIA_VERSION=2025-04-16
CARTESIA_TTS_MODEL=sonic-3
# Kiefer (male, stable): 228fca29-3a0a-435c-8728-5cb483251068
CARTESIA_VOICE_ID=228fca29-3a0a-435c-8728-5cb483251068
